# Copy this file to .env and edit for your local build machine.
# Values in .env are ignored by git but are embedded into the APK you build.

# Android emulator default. For a real phone, use your LAN/VPN server URL, e.g.
# KOKORO_SERVER_BASE=http://YOUR-LAN-OR-VPN-HOST:8880
KOKORO_SERVER_BASE=http://10.0.2.2:8880
