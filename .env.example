# Copy this file to .env and edit for your local build/test machine.
# Values in .env are ignored by git but KOKORO_SERVER_BASE is embedded into
# the APK as the initial default server URL.

# Android emulator default. For a real phone, use your LAN/VPN server URL.
KOKORO_SERVER_BASE=http://10.0.2.2:8880

# Optional host-side real-server smoke-test settings. These do not affect the
# APK. Keeping them separate lets you test a candidate backend before changing
# the Android build default. Example values for qwentts.cpp are shown; set the
# server URL to the same LAN/VPN address the phone will use.
# TTS_SMOKE_SERVER_BASE=
# TTS_SMOKE_MODEL=qwen-0.6-customvoice-q8-ggml
# TTS_SMOKE_VOICE=ryan
# TTS_SMOKE_FORMAT=wav
# TTS_SMOKE_LANG_CODE=
# TTS_SMOKE_RUNS=3
