# Copy this file to .env or .env.local and edit for your local build/test machine.
# Values in these files are ignored by git. KOKORO_SERVER_BASE is embedded into
# the APK as the initial default server URL; saved in-app settings still take
# precedence once the app has been configured on a device.

# Android emulator default. For a real phone, use your LAN/VPN server URL.
KOKORO_SERVER_BASE=http://10.0.2.2:8880

# Optional host-side real-server smoke/listen settings. These do not select the
# Android model/voice defaults; configure those once in the app's Settings.
# For the local-ai qwentts MP3 gateway, use the gateway port (11437), not the
# raw qwentts WAV-only engine port (11436).
# TTS_SMOKE_SERVER_BASE=http://YOUR-LAN-OR-VPN-HOST:11437
# TTS_SMOKE_MODEL=qwen-0.6-customvoice-q8-ggml
# TTS_SMOKE_VOICE=ryan
# TTS_SMOKE_FORMAT=mp3
# TTS_SMOKE_LANG_CODE=English
# TTS_SMOKE_RUNS=3

# Optional listen-gate override. The default is a paragraph-length quality
# probe because very short Qwen3-TTS utterances are not representative.
# TTS_LISTEN_TEXT=Replace this with a representative paragraph if desired.
# TTS_LISTEN_NO_AUTOPLAY=0
